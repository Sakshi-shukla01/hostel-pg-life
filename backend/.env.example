# Copy this file to .env and fill in values.

# FREE Gemini key (no card needed): https://aistudio.google.com/apikey
# Leave empty and the app still works using its built-in offline AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

MONGO_URL=mongodb://localhost:27017
MONGO_DB=hostelpg
REDIS_URL=
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
AI_DAILY_LIMIT_PER_USER=100

# --- Email codes (sign-up verification + forgot password) ---
# Free with Gmail: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords  (16 letters, paste without spaces)
# Leave SMTP_USER empty to print codes in this terminal instead (dev mode).
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SHOW_DEV_CODES=true

# --- Google sign-in (optional) ---
# OAuth Client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
